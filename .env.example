# Copy to .env.local for local development, and set the same values in the
# Vercel project settings for preview and production.

# ---------------------------------------------------------------------------
# Contact form (REQUIRED — the form returns a 500 until these are set)
# ---------------------------------------------------------------------------
# 1. Create an account at https://resend.com
# 2. Add and verify the sending domain (urbanreachtx.com) under Domains —
#    this means adding the DNS records Resend gives you. Until the domain is
#    verified you can only send to the address that owns the Resend account.
# 3. Create an API key at https://resend.com/api-keys with Sending access.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
CONTACT_FROM="Urban Reach Website <website@urbanreachtx.com>"

# Where inquiries are delivered. Defaults to info@urbanreachtx.com if unset.
CONTACT_TO=info@urbanreachtx.com

# ---------------------------------------------------------------------------
# Canonical URL
# ---------------------------------------------------------------------------
# Drives canonical tags, sitemap.xml, robots.txt, and JSON-LD.
# Point this at the staging URL for client review, and only switch it to the
# live domain as part of the deliberate DNS cutover.
NEXT_PUBLIC_SITE_URL=https://urbanreachtx.com
